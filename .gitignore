# Build outputs
target/
**/target/
.wasi-sdk/
crates/mcpone-python-runtime/libs/decompressed/

# Legacy host experiments (not part of monocp target path)
third_party/

# Local test/runtime data
crates/mcpone-python-wasm-runtime/tests/python-stdlib/
crates/mcpone-python-wasm-runtime/tests/site-packages/

# Cargo extraction metadata
**/.cargo-ok
**/.cargo_vcs_info.json

# Python cache
**/__pycache__/
**/*.pyc

# OS cruft
**/.DS_Store

# Stage 2 threaded CPython build tree (cloned source + build outputs, ~380M).
# The resulting artifacts are committed (compressed) under threads-artifacts/.
threads-build/

# Decompressed Stage-2 artifacts (derived; the .zst originals are committed).
threads-artifacts/decompressed/

# Stage-3 scratch (regenerated by scripts/componentize-cpython-threads.sh).
threads-stage3/scratch/

# Stage-C scratch + large built bridge modules (regenerated by
# scripts/build-cpython-threads-bridge.sh; compressed .zst is committed).
threads-stage3/scratch-c/
threads-stage3/bridge/
threads-stage3/*.wasm
# Derived backend-install assets (bridge .wasm + merged stdlib), produced by
# scripts/prepare-threaded-python-assets.sh; the bridge .zst is committed and
# the stdlib is reproduced from the (gitignored) Stage-2 build tree.
threads-stage3/assets/
